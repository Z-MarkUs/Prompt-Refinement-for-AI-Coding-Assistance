# This is a variable-name template; the package does not automatically load this file.
# Model IDs are intentionally configuration, not repository claims.
# Check the provider's current model catalog before starting a paid run.
PROMPT_EVAL_RUN_ID=run-YYYY-MM-DD-001
PROMPT_EVAL_GENERATOR_MODEL=your-generator-model-id
PROMPT_EVAL_REFINER_MODEL=your-refiner-model-id
PROMPT_EVAL_GENERATOR_TEMPERATURE=0
PROMPT_EVAL_REFINER_TEMPERATURE=0
PROMPT_EVAL_GENERATOR_TOP_P=none
PROMPT_EVAL_REFINER_TOP_P=none
PROMPT_EVAL_GENERATOR_MAX_OUTPUT_TOKENS=2048
PROMPT_EVAL_REFINER_MAX_OUTPUT_TOKENS=2048

# Never commit a real key. The OpenAI SDK also reads OPENAI_API_KEY by default.
OPENAI_API_KEY=replace-locally
